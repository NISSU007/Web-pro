<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AUNTIE-AUN Restaurant - Menu</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/menu" class="active">Menu</a>
        <a href="/cart">Cart</a>
    </nav>

    <div class="container">
        <h1 class="title">AUNTIE-AUN Restaurant</h1>

        <div class="menu-grid">
            <% menuItems.forEach(item => { 
                // เพิ่ม item.product_id เข้าไปจุดแรก
                const itemId = item.product_id || item.id || item._id || item.food_id || item.foodId || '';

                // จัดการ URL ของรูปภาพ (API ส่ง image_url มาอยู่แล้ว)
                let itemImg = item.image_url || item.image || item.img || item.imageUrl || '';
                if (itemImg && !itemImg.startsWith('http')) {
                    if (!itemImg.startsWith('/')) itemImg = '/' + itemImg;
                    itemImg = 'http://webdev.it.kmitl.ac.th:4000' + itemImg;
                }
            %>
                <div class="card">
                    <img src="<%= itemImg %>" alt="<%= item.name %>">
                    <div class="card-body">
                        <h3><%= item.name %></h3>
                        <p class="description"><%= item.description %></p>
                        <div class="card-footer">
                            <span class="price"><%= item.price %> THB</span>
                            <a href="/add-to-cart/<%= itemId %>" class="btn-add">Add to Cart</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</body>
</html>
