<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขข้อมูลสินค้า</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container edit-card card">
        <h2>แก้ไขข้อมูลสินค้า (ID: <%= product.id %>)</h2>
        <form action="/edit/<%= product.id %>" method="POST">
            <div class="form-group">
                <label>ชื่อสินค้า</label>
                <input type="text" name="name" value="<%= product.name %>" required>
            </div>
            <div class="form-group">
                <label>หมวดหมู่</label>
                <input type="text" name="category" value="<%= product.category %>" required>
            </div>
            <div class="form-group">
                <label>ราคา (บาท)</label>
                <input type="number" name="price" value="<%= product.price %>" required>
            </div>
            <div class="form-actions">
                <a href="/" class="btn btn-cancel">ยกเลิก</a>
                <button type="submit" class="btn btn-blue">บันทึกการแก้ไข</button>
            </div>
        </form>
    </div>
</body>
</html>
