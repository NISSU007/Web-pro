<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create a New Todo</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container" style="max-width: 600px;">
        <h2 style="margin-bottom: 20px;">Create a New Todo</h2>
        <!-- ส่ง POST ไปที่ /add -->
        <form action="/add" method="POST">
            <div class="form-group">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" placeholder="Enter title" required>
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="4" placeholder="Enter description"></textarea>
            </div>
            <div class="form-group">
                <label for="deadline">Deadline:</label>
                <input type="date" id="deadline" name="deadline" required>
            </div>
            <button type="submit" class="btn-submit">Create Todo</button>
            <a href="/" class="btn-cancel" style="margin-left: 10px; color: #555; text-decoration: none; font-size: 14px;">Cancel</a>
        </form>
    </div>
</body>
</html>
